# Second Button: shared sandbox credentials for local development.
# Copy to .env.local and fill in. Never commit .env.local.

# PayPal sandbox app (developer.paypal.com > Apps & Credentials > Sandbox)
PAYPAL_ENV="sandbox"
PAYPAL_CLIENT_ID=""
PAYPAL_CLIENT_SECRET=""
# Filled in during Phase 2, once the webhook relay has a public URL
PAYPAL_WEBHOOK_ID=""

# Sandbox *Personal* (buyer) account the harness logs in with
# (developer.paypal.com > Testing Tools > Sandbox Accounts)
PAYPAL_SANDBOX_BUYER_EMAIL=""
PAYPAL_SANDBOX_BUYER_PASSWORD=""

# Stripe TEST mode (harness Stripe parity runs)
STRIPE_SECRET_KEY=""

# Anthropic API key for the agent
ANTHROPIC_API_KEY=""
